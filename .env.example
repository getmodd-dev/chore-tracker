# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gmail SMTP Configuration for Automated Daily Chore Reports
# GMAIL_USER: Your Gmail address sending the daily reports (e.g., familychores@gmail.com)
GMAIL_USER=""

# GMAIL_APP_PASSWORD: 16-character Google App Password generated at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=""

# PARENT_EMAIL: Recipient parent email address for daily chore results (e.g., parent@example.com)
PARENT_EMAIL=""

# DAILY_REPORT_TIME: Daily report time in 24-hour HH:MM format (defaults to 20:00 / 8:00 PM)
DAILY_REPORT_TIME="20:00"

# Pushover API Configuration for iPhone Push Notifications
# PUSHOVER_APP_TOKEN: 30-character Application API Token from https://pushover.net/apps/build
PUSHOVER_APP_TOKEN=""

